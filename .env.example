# Live Notion feed for the dashboard (used by /api/sites on Vercel).
# Copy to .env for local `vercel dev`, and set the same vars in
# Vercel → Project → Settings → Environment Variables for production.

# Internal integration secret from https://www.notion.so/my-integrations (starts with "ntn_").
NOTION_TOKEN=

# Optional — defaults to the Site Operations Master database.
# NOTION_DATABASE_ID=6c92249e087348b0a9d713cbbbbdc959
